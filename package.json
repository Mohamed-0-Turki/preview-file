{
  "name": "@mohamed-0-turki/preview-file",
  "version": "0.1.5",
  "description": "A framework-agnostic file preview library for images, PDFs, documents, spreadsheets, text files, and more.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-icons.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/build-icons.mjs && npm run typecheck && npm run build"
  },
  "keywords": [
    "file",
    "file-preview",
    "file-viewer",
    "preview",
    "viewer",
    "document-preview",
    "pdf-viewer",
    "image-viewer",
    "excel-viewer",
    "word-viewer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohamed-0-Turki/preview-file.git"
  },
  "bugs": {
    "url": "https://github.com/Mohamed-0-Turki/preview-file/issues"
  },
  "homepage": "https://github.com/Mohamed-0-Turki/preview-file#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "pdfjs-dist": "^6.3.289",
    "xlsx": "^0.18.5"
  }
}
